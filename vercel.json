{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/private",
      "destination": "/"
    },
    {
      "source": "/support",
      "destination": "/"
    },
    {
      "source": "/privacy",
      "destination": "/"
    },
    {
      "source": "/love/:path*",
      "destination": "/"
    },
    {
      "source": "/open/:theme/:token",
      "destination": "/api/love-preview?theme=:theme&token=:token"
    }
  ]
}